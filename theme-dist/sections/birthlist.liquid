{% comment %}
  כלי תכנון רשימת לידה — me & mommy (שלב F).
  נבנה אוטומטית מ-ui/birthlist.html על ידי build_theme.py. לא לערוך ידנית — כל שינוי יימחק בבנייה הבאה.
  המבנה בקוד; צבעים / גופנים / טקסטים / תמונות — מהעורך (הגדרות המקטע).
{% endcomment %}
{%- liquid
  assign cs = section.settings.color_scheme.settings
-%}
{%- if section.settings.fonts == 'brand' -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Varela+Round&family=Assistant:wght@400;600;700&display=swap">
{%- endif -%}
{{ 'birthlist.css' | asset_url | stylesheet_tag }}
<style>
  #bl {
  {%- if section.settings.colors == 'theme' %}
    --bg: {{ cs.background }};
    --surface: {{ cs.background | color_lighten: 100 }};
    --surface-2: {{ cs.button | color_mix: cs.background, 12 }};
    --ink: {{ cs.text }};
    --ink-2: {{ cs.text | color_mix: cs.background, 78 }};
    --muted: {{ cs.text | color_mix: cs.background, 55 }};
    --line: {{ cs.text | color_mix: cs.background, 12 }};
    --peach-deep: {{ cs.button }};
    --peach: {{ cs.button | color_mix: cs.background, 70 }};
    --peach-soft: {{ cs.button | color_mix: cs.background, 25 }};
    --peach-ink: {{ cs.button | color_darken: 22 }};
    --shadow: 0 8px 28px {{ cs.shadow | color_modify: 'alpha', 0.10 }};
    --shadow-lg: 0 18px 50px {{ cs.shadow | color_modify: 'alpha', 0.18 }};
  {%- endif %}
  {%- if section.settings.fonts == 'theme' %}
    --font-body: var(--font-body-family);
    --font-head: var(--font-heading-family);
  {%- endif %}
  }
  #bl .btn.primary { color: {% if section.settings.colors == 'theme' %}{{ cs.button_label }}{% else %}#fff{% endif %}; }
</style>

<div id="bl" dir="rtl" lang="he">

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></symbol>
  <symbol id="i-list" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 9h8M8 12.5h8M8 16h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-wallet" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 10h18" stroke="currentColor" stroke-width="2"/><circle cx="16.5" cy="14.5" r="1.4" fill="currentColor"/></symbol>
  <symbol id="i-cal" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-gift" viewBox="0 0 24 24"><rect x="3" y="9" width="18" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 13h18M12 9v12M12 9c-2-4-6-4-6-1.5S10 9 12 9zm0 0c2-4 6-4 6-1.5S14 9 12 9z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-back" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></symbol>
  <symbol id="i-bottle" viewBox="0 0 24 24"><path d="M10 3h4v3h-4zM9 6h6v3H9zM8 9h8v10a2 2 0 01-2 2h-4a2 2 0 01-2-2V9z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M11 13h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
</svg>
<!-- טעינה / שגיאה -->
<div id="screen-loading" class="full"><div class="step" style="justify-content:center;text-align:center"><div class="spinner"></div><p class="lead">טוענים את המחירים העדכניים…</p></div></div>
<div id="screen-error" class="full" hidden><div class="step" style="justify-content:center;text-align:center"><h1>לא הצלחנו לטעון את המחירים</h1><p class="lead" id="errMsg"></p><div class="nav" style="justify-content:center"><button class="btn primary" id="btnRetry">לנסות שוב</button></div></div></div>
<!-- שאלות פתיחה -->
<div id="screen-onboard" class="full" hidden></div>
<!-- הרשימה נבנית -->
<div id="screen-build" class="full" hidden></div>
<!-- הרשמה -->
<div id="screen-signin" class="full" hidden></div>
<!-- האפליקציה -->
<div class="wrap" id="app" hidden>
  <div class="hdr" id="hdr">
    <div class="hello"><h1 id="helloTitle">הרשימה שלי</h1><p id="helloSub"></p></div>
    <div class="acts"><button class="iconbtn" id="btnSettings" title="הגדרות" aria-label="הגדרות"><svg><use href="#i-gear"/></svg></button></div>
  </div>
  <div id="staleBanner" class="banner" hidden></div>
  <section class="view active" id="view-list">
    <div class="hero" id="hero"></div>
    <div class="filters">
      <div class="chips" id="tagChips"></div>
      <div class="searchbox"><input id="search" type="search" placeholder="חיפוש פריט…" aria-label="חיפוש פריט"><svg><use href="#i-search"/></svg></div>
    </div>
    <div id="cats"></div>
    <p class="foot-note" id="footNote"></p>
  </section>
  <section class="view" id="view-months"></section>
  <section class="view" id="view-gifts"></section>
  <section class="view" id="view-budget"></section>
</div>
<button class="btn primary fab" id="fabAdd" hidden><svg class="icon"><use href="#i-plus"/></svg> מוצר משלי</button>
<nav class="nav-bottom" id="tabs" aria-label="ניווט" hidden>
  <div class="in">
    <button role="tab" data-view="list" aria-selected="true"><svg><use href="#i-list"/></svg>הרשימה</button>
    <button role="tab" data-view="months" aria-selected="false"><svg><use href="#i-cal"/></svg>לפי חודשים</button>
    <button role="tab" data-view="gifts" aria-selected="false"><svg><use href="#i-gift"/></svg>מתנות</button>
    <button role="tab" data-view="budget" aria-selected="false"><svg><use href="#i-wallet"/></svg>סיכום</button>
  </div>
</nav>
<div class="sheet-bg" id="sheetBg" hidden><div class="sheet" role="dialog" aria-modal="true" id="sheet"></div></div>
<div class="modal-bg" id="modalBg" hidden><div class="modal" role="dialog" aria-modal="true" id="modal"></div></div>
<div class="toast" id="toast" hidden></div>

</div>

<script type="application/json" id="bl-settings">
{
  "config": {
    "SHOW_IMAGES": {{ section.settings.show_images | json }},
    "STALE_WARN_DAYS": {{ section.settings.stale_warn_days | json }},
    "STALE_HIDE_DAYS": {{ section.settings.stale_hide_days | json }},
    "STORE_HOME": {{ shop.url | json }}
  },
  "text": {
    "brand": {{ section.settings.t_brand | escape | json }},
    "ob0_title": {{ section.settings.t_ob0_title | json }},
    "ob0_lead": {{ section.settings.t_ob0_lead | json }},
    "ob0_sub": {{ section.settings.t_ob0_sub | json }},
    "ob0_btn": {{ section.settings.t_ob0_btn | json }},
    "ob1_title": {{ section.settings.t_ob1_title | json }},
    "ob1_lead": {{ section.settings.t_ob1_lead | json }},
    "ob2_title": {{ section.settings.t_ob2_title | json }},
    "ob2_lead": {{ section.settings.t_ob2_lead | json }},
    "ob2_btn": {{ section.settings.t_ob2_btn | json }},
    "build_title": {{ section.settings.t_build_title | json }},
    "build_btn": {{ section.settings.t_build_btn | json }},
    "signin_title": {{ section.settings.t_signin_title | json }},
    "signin_lead": {{ section.settings.t_signin_lead | json }},
    "signin_btn": {{ section.settings.t_signin_btn | json }},
    "signin_tiny": {{ section.settings.t_signin_tiny | json }}
  },
  "img": {
    {% if section.settings.img_hello != blank %}"hello": {{ section.settings.img_hello | image_url: width: 480 | json }},{% endif %}
    {% if section.settings.img_date != blank %}"date": {{ section.settings.img_date | image_url: width: 480 | json }},{% endif %}
    {% if section.settings.img_first != blank %}"first": {{ section.settings.img_first | image_url: width: 480 | json }},{% endif %}
    {% if section.settings.img_lock != blank %}"lock": {{ section.settings.img_lock | image_url: width: 480 | json }},{% endif %}
    "_": null
  }
}
</script>
<script src="{{ 'birthlist.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "כלי רשימת לידה",
  "tag": "section",
  "class": "section-birthlist",
  "limit": 1,
  "templates": [
    "page"
  ],
  "settings": [
    {
      "type": "header",
      "content": "עיצוב"
    },
    {
      "type": "select",
      "id": "colors",
      "label": "צבעים",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "מערכת הצבעים של התמה (למטה)"
        },
        {
          "value": "brand",
          "label": "הפלטה הקבועה של הכלי (קרם / אפרסק / חום)"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "מערכת צבעים",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "fonts",
      "label": "גופנים",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "הגופנים של התמה"
        },
        {
          "value": "brand",
          "label": "Varela Round + Assistant (הגופנים של הכלי)"
        }
      ]
    },
    {
      "type": "header",
      "content": "מסך הפתיחה"
    },
    {
      "type": "text",
      "id": "t_brand",
      "label": "שם המותג (למעלה)",
      "default": "me & mommy"
    },
    {
      "type": "image_picker",
      "id": "img_hello",
      "label": "איור (במקום הציור המובנה)"
    },
    {
      "type": "text",
      "id": "t_ob0_title",
      "label": "כותרת",
      "default": "היי, ברוכים הבאים 🌸"
    },
    {
      "type": "textarea",
      "id": "t_ob0_lead",
      "label": "טקסט ({stores} = מספר החנויות)",
      "default": "בעוד רגע תהיה לכם רשימה מסודרת של כל מה שצריך ללידה — עם מחירים אמיתיים מ-{stores} חנויות, והכי זול מסומן."
    },
    {
      "type": "text",
      "id": "t_ob0_sub",
      "label": "שורה שנייה",
      "default": "שתי שאלות קצרות, ומתחילים."
    },
    {
      "type": "text",
      "id": "t_ob0_btn",
      "label": "כפתור",
      "default": "מתחילים"
    },
    {
      "type": "header",
      "content": "שאלה 1 — תאריך"
    },
    {
      "type": "image_picker",
      "id": "img_date",
      "label": "איור"
    },
    {
      "type": "text",
      "id": "t_ob1_title",
      "label": "כותרת",
      "default": "מתי התאריך המשוער?"
    },
    {
      "type": "text",
      "id": "t_ob1_lead",
      "label": "טקסט",
      "default": "לפי זה נפרוס את הקניות על החודשים שנשארו."
    },
    {
      "type": "header",
      "content": "שאלה 2 — לידה ראשונה"
    },
    {
      "type": "image_picker",
      "id": "img_first",
      "label": "איור"
    },
    {
      "type": "text",
      "id": "t_ob2_title",
      "label": "כותרת",
      "default": "זו הלידה הראשונה?"
    },
    {
      "type": "text",
      "id": "t_ob2_lead",
      "label": "טקסט",
      "default": "ככה נדע כמה להסביר, ומה כנראה כבר יש בבית."
    },
    {
      "type": "text",
      "id": "t_ob2_btn",
      "label": "כפתור",
      "default": "בונים את הרשימה ✨"
    },
    {
      "type": "header",
      "content": "הרשימה נבנית"
    },
    {
      "type": "text",
      "id": "t_build_title",
      "label": "כותרת",
      "default": "בונים את הרשימה…"
    },
    {
      "type": "text",
      "id": "t_build_btn",
      "label": "כפתור בסיום",
      "default": "לרשימה שלי ←"
    },
    {
      "type": "header",
      "content": "מסך ההרשמה"
    },
    {
      "type": "image_picker",
      "id": "img_lock",
      "label": "איור"
    },
    {
      "type": "text",
      "id": "t_signin_title",
      "label": "כותרת",
      "default": "עוד צעד קטן 🌸"
    },
    {
      "type": "text",
      "id": "t_signin_lead",
      "label": "טקסט",
      "default": "התשובות שלכם שמורות. כדי שהרשימה תישמר לתמיד ותחכה לכם מכל מכשיר — מתחברים; בעמוד הבא בוחרים איך: Google, Shop או מייל עם קוד."
    },
    {
      "type": "text",
      "id": "t_signin_btn",
      "label": "כפתור",
      "default": "להרשמה / התחברות"
    },
    {
      "type": "text",
      "id": "t_signin_tiny",
      "label": "שורה קטנה",
      "default": "בלי סיסמאות. הפרטים לא נמסרים לאף חנות."
    },
    {
      "type": "header",
      "content": "מחירים ותמונות (לדניאל)"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "להציג תמונות מוצרים",
      "default": true
    },
    {
      "type": "range",
      "id": "stale_warn_days",
      "label": "אזהרה על מחיר ישן — אחרי כמה ימים",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "ימ",
      "default": 7
    },
    {
      "type": "range",
      "id": "stale_hide_days",
      "label": "הסתרת חנות שלא נסרקה — אחרי כמה ימים",
      "min": 7,
      "max": 90,
      "step": 1,
      "unit": "ימ",
      "default": 30
    }
  ]
}
{% endschema %}
